<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipJournal</AssemblyName>
    <RootNamespace>ClipJournal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>quillreverie</Authors>
    <Product>ClipJournal</Product>
    <Description>Windows clipboard text collector that appends each copy as a single line to a local txt file.</Description>
    <RepositoryUrl>https://github.com/quillreverie/clip-journal</RepositoryUrl>
    <PackageProjectUrl>https://github.com/quillreverie/clip-journal</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Pin the default publish target so `dotnet publish` without explicit flags
         produces a consistent win-x64 build instead of a framework-dependent,
         architecture-agnostic one that fails to start the clipboard listener on a
         machine without the Desktop Runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained single-file publishes are opt-in via `dotnet publish -p:SelfContained=true`.
         Kept off by default so the README's framework-dependent flow still wins; the
         lines below are inert unless the caller passes the matching property. -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
